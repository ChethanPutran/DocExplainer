# The image holds the backend service only: it needs pyproject.toml, uv.lock, ReadMe.md, LICENSE, MANIFEST.in and src/.

# Secrets and local settings: never bake these into an image
.env
.env.*
config/

# Environments and caches (several GB)
.venv/
venv/
**/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
**/*.egg-info/

# Not part of the backend image
.git/
.gitignore
.vscode/
ui/
sdk/
tests/
docs/
scripts/
eamples/
output/
data/
db/
CLAUDE.md
Dockerfile
.dockerignore
=7.4.0
